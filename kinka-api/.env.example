# ============================================================
# kinka-api — Configuration d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs réelles
# ============================================================

# ─── Serveur ──────────────────────────────────────
PORT=3000
# En production, mettre NODE_ENV=production pour activer la whitelist CORS
NODE_ENV=development

# ─── Base de données MySQL ────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kinka_db
DB_USER=root
DB_PASS=change_me

# ─── Sécurité JWT ─────────────────────────────────
# Générer une clé robuste avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
# URL du front (Live Server). En prod : https://www.kinka.fr
CLIENT_URL=http://127.0.0.1:5503
# Optionnel : liste blanche d'origines autorisées en prod (séparées par des virgules).
# Si vide, CLIENT_URL est utilisé. N'a d'effet que si NODE_ENV=production.
# CORS_ORIGINS=https://www.kinka.fr,https://kinka.fr
