# ============================================================
# kinka-api — Configuration d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs réelles
# ============================================================

# ─── Serveur ──────────────────────────────────────
PORT=3000
# En production, mettre NODE_ENV=production pour activer la whitelist CORS
NODE_ENV=development

# ─── Base de données MySQL ────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kinka_db
DB_USER=root
DB_PASS=change_me

# ─── Sécurité JWT ─────────────────────────────────
# Générer une clé robuste avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Envoi d'emails ───────────────────────────────
# Adresse affichée comme expéditeur et adresse de contact en pied d'email
MAIL_FROM=KINKA.FR <no-reply@kinka.fr>
MAIL_SUPPORT=support@kinka.fr
#
# Trois modes possibles :
#
# 1) SMTP réel — renseigner MAIL_HOST. Les emails partent vraiment.
#    Exemple Gmail (mot de passe d'application obligatoire, pas le mot de passe du compte) :
#      MAIL_HOST=smtp.gmail.com
#      MAIL_PORT=587
#      MAIL_SECURE=false
#      MAIL_USER=votre.adresse@gmail.com
#      MAIL_PASS=mot_de_passe_application
#    Exemple Mailtrap / Brevo / OVH : adapter hôte, port et identifiants.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
#
# 2) Boîte de test jetable (aucun compte à créer) : l'email part sur un vrai
#    serveur SMTP et une URL de prévisualisation s'affiche dans la console.
MAIL_TEST=1
#
# 3) Ni l'un ni l'autre : l'email est simplement journalisé en console.

# ─── CORS ─────────────────────────────────────────
# URL du front (Live Server). En prod : https://www.kinka.fr
CLIENT_URL=http://127.0.0.1:5503
# Optionnel : liste blanche d'origines autorisées en prod (séparées par des virgules).
# Si vide, CLIENT_URL est utilisé. N'a d'effet que si NODE_ENV=production.
# CORS_ORIGINS=https://www.kinka.fr,https://kinka.fr
